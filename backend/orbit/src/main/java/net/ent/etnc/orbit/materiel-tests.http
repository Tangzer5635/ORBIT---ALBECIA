### ---------------------------------------------------------------------
### MODIFICATION
### ---------------------------------------------------------------------

### M1 - Modifier un matériel affecté (1, sur poste 1)
PUT {{api}}/materiels/1/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numSerie": "UC-0001",
  "modele": "Dell OptiPlex 7020",
  "dateFinGarantie": "2027-09-01",
  "dateAcquisition": "2024-09-01",
  "type": "UC"
}

> {%
    client.test("M1 - PUT matériel affecté -> 200, modèle changé, état reste NORMAL", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.modele === "Dell OptiPlex 7020", "Modele " + response.body.modele);
        client.assert(response.body.etat === "NORMAL", "Etat " + response.body.etat);
    });
%}

### M2 - Modifier un matériel à garantie expirée (5, sur poste 3)
PUT {{api}}/materiels/5/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numSerie": "UC-0003",
  "modele": "HP EliteDesk 800 G6",
  "dateFinGarantie": "2025-09-01",
  "dateAcquisition": "2022-09-01",
  "type": "UC"
}

> {%
    client.test("M2 - PUT garantie expirée -> 200, état calculé A_REMPLACER", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.etat === "A_REMPLACER", "Etat " + response.body.etat);
    });
%}

### M2b - Prolonger la garantie du matériel 5
PUT {{api}}/materiels/5/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numSerie": "UC-0003",
  "modele": "HP EliteDesk 800 G6",
  "dateFinGarantie": "2029-09-01",
  "dateAcquisition": "2022-09-01",
  "type": "UC"
}

> {%
    client.test("M2b - Garantie prolongée -> état recalculé NORMAL", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.etat === "NORMAL", "Etat " + response.body.etat);
    });
%}

