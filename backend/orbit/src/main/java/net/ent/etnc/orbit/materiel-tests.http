### =====================================================================
### ORBIT - Tests API matériel V2 (état calculé, stock = salle de stockage)
### Prérequis : back redémarré (ddl-auto: create) => jeu de données Init tout neuf
### Lancer : "Run All Requests in File" puis exporter les résultats
### =====================================================================

@host = http://localhost:8080
@api = {{host}}/api/v1

### ---------------------------------------------------------------------
### AUTH
### ---------------------------------------------------------------------

### A1 - Login gestionnaire
POST {{api}}/auth/login/
Content-Type: application/json

{ "username": "r.besnard", "password": "12345" }

> {%
    client.test("A1 - Login gestionnaire -> 200 + token", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(!!response.body.accessToken, "Pas de accessToken");
    });
    client.global.set("token", response.body.accessToken);
%}

### A2 - Login stagiaire
POST {{api}}/auth/login/
Content-Type: application/json

{ "username": "t.lebuhe", "password": "1595" }

> {%
    client.test("A2 - Login stagiaire -> 200", () => {
        client.assert(response.status === 200, "Status " + response.status);
    });
    client.global.set("tokenStagiaire", response.body.accessToken);
%}

### A3 - Login compte désactivé
POST {{api}}/auth/login/
Content-Type: application/json

{ "username": "p.inactif", "password": "1595" }

> {%
    client.test("A3 - Login compte désactivé -> 401", () => {
        client.assert(response.status === 401, "Status " + response.status);
    });
%}

### A4 - Login mauvais mot de passe
POST {{api}}/auth/login/
Content-Type: application/json

{ "username": "r.besnard", "password": "faux" }

> {%
    client.test("A4 - Mauvais mot de passe -> 401", () => {
        client.assert(response.status === 401, "Status " + response.status);
    });
%}

### ---------------------------------------------------------------------
### LECTURE
### ---------------------------------------------------------------------

### L1 - Liste des matériels
GET {{api}}/materiels/
Authorization: Bearer {{token}}

> {%
    client.test("L1 - Liste -> 200, 12 matériels", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.content.length === 12, "Nb = " + response.body.content.length);
    });
%}

### L2 - Détail d'un matériel en stock (8)
GET {{api}}/materiels/8/
Authorization: Bearer {{token}}

> {%
    client.test("L2 - Matériel 8 -> DISPONIBLE, avec type et dateAcquisition", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.etat === "DISPONIBLE", "Etat " + response.body.etat);
        client.assert(response.body.type === "UC", "Type " + response.body.type);
        client.assert(!!response.body.dateAcquisition, "Pas de dateAcquisition");
    });
%}

### L3 - Matériel inexistant
GET {{api}}/materiels/9999/
Authorization: Bearer {{token}}

> {%
    client.test("L3 - Matériel inexistant -> 404", () => {
        client.assert(response.status === 404, "Status " + response.status);
    });
%}

### ---------------------------------------------------------------------
### CRÉATION
### ---------------------------------------------------------------------

### C1 - Création avec un etat forcé (doit être ignoré)
POST {{api}}/materiels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numSerie": "TEST-0001",
  "modele": "Dell P2422H",
  "dateFinGarantie": "2028-01-01",
  "dateAcquisition": "2026-01-01",
  "type": "Ecran",
  "etat": "NORMAL",
  "idStockage": 3
}

> {%
    client.test("C1 - Création -> 200, état forcé à DISPONIBLE", () => {
        client.assert(response.status === 200, "Status " + response.status);
        client.assert(response.body.etat === "DISPONIBLE", "Etat " + response.body.etat);
    });
    client.global.set("idCree", response.body.id);
%}

### C2 - Création d'un TableauInteractif (bug longueur colonne type)
POST {{api}}/materiels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numSerie": "TBI-TEST",
  "modele": "Promethean ActivPanel",
  "dateFinGarantie": "2029-01-01",
  "dateAcquisition": "2026-01-01",
  "type": "TableauInteractif",
  "idStockage": 3
}

> {%
    client.test("C2 - Création TableauInteractif -> 200", () => {
        client.assert(response.status === 200, "Status " + response.status);
    });
    client.global.set("idTbi", response.body.id);
%}

