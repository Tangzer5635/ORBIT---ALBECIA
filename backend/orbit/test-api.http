### ============================================================
### Tests du template_auth_sb
### À lancer DANS L'ORDRE ("Run All Requests"), juste après le démarrage de l'app
### (ddl-auto: create → base vide à chaque lancement)
### ============================================================

@host = http://localhost:8080


### ================= A. AUTH / REFRESH TOKEN =================

### 1. Login admin OK → 200 + accessToken + cookie refresh
POST {{host}}/api/v1/auth/login/
Content-Type: application/json

{"username": "admin", "password": "admin1234"}

> {%
    client.test("200 + token", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.accessToken, "pas de token");
    });
    client.global.set("adminToken", response.body.accessToken);
    // on garde le refresh brut pour le test de vol (étape 5)
    client.global.set("refreshR1", response.headers.valueOf("Set-Cookie").split(";")[0].split("=")[1]);
%}

### 2. Mauvais mot de passe → 401 "Identifiants invalides"
POST {{host}}/api/v1/auth/login/
Content-Type: application/json

{"username": "admin", "password": "faux"}

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}

### 3. Champs vides → 400 avec le détail par champ
POST {{host}}/api/v1/auth/login/
Content-Type: application/json

{"username": "", "password": ""}

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 4. Refresh (cookie envoyé automatiquement) → 200 + nouveau token
POST {{host}}/api/v1/auth/refresh/

> {%
    client.test("200", () => client.assert(response.status === 200, "status " + response.status));
    client.global.set("refreshR2", response.headers.valueOf("Set-Cookie").split(";")[0].split("=")[1]);
%}

### 5. VOL : on rejoue l'ancien refresh R1 (déjà utilisé) → 400 RG-SEC02 + famille révoquée
# @no-cookie-jar
POST {{host}}/api/v1/auth/refresh/
Cookie: template_auth_refresh={{refreshR1}}

> {% client.test("400 vol détecté", () => client.assert(response.status === 400, "status " + response.status)); %}

### 6. Le refresh "légitime" R2 est aussi mort (famille révoquée) → 400
### Si ça renvoie 200 : le noRollbackFor ne marche pas
# @no-cookie-jar
POST {{host}}/api/v1/auth/refresh/
Cookie: template_auth_refresh={{refreshR2}}

> {% client.test("400 famille révoquée", () => client.assert(response.status === 400, "status " + response.status)); %}

### 7. Refresh sans cookie → 400 RG-SEC10
# @no-cookie-jar
POST {{host}}/api/v1/auth/refresh/

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 8. Re-login admin (nouvelle famille)
POST {{host}}/api/v1/auth/login/
Content-Type: application/json

{"username": "admin", "password": "admin1234"}

> {% client.global.set("adminToken", response.body.accessToken); %}

### 9. Logout → 204 + cookie supprimé
POST {{host}}/api/v1/auth/logout/

> {% client.test("204", () => client.assert(response.status === 204, "status " + response.status)); %}

### 10. Refresh après logout → 400 (plus de cookie)
POST {{host}}/api/v1/auth/refresh/

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}


### ================= B. SÉCURITÉ DE BASE =================
### (l'access token de l'étape 8 reste valide après logout : c'est normal, il est stateless)

### 11. Sans token → 401
GET {{host}}/api/v1/users/

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}

### 12. Token bidon → 401
GET {{host}}/api/v1/users/
Authorization: Bearer nimportequoi

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}


### ================= C. CRUD USERS (admin) =================

### 13. Liste → 200
GET {{host}}/api/v1/users/
Authorization: Bearer {{adminToken}}

> {% client.test("200", () => client.assert(response.status === 200, "status " + response.status)); %}

### 14. Id inexistant → 404
GET {{host}}/api/v1/users/999
Authorization: Bearer {{adminToken}}

> {% client.test("404", () => client.assert(response.status === 404, "status " + response.status)); %}

### 15. Création OK → 200 (ou 201 si tu l'as changé)
POST {{host}}/api/v1/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "testuser", "password": "test1234", "role": "USER"}

> {%
    client.test("2xx", () => client.assert(response.status < 300, "status " + response.status));
    client.global.set("userId", response.body.id);
%}

### 16. Username déjà pris → 400
POST {{host}}/api/v1/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "testuser", "password": "test1234", "role": "USER"}

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 17. DTO invalide (username vide, pas de rôle) → 400 avec détail par champ
POST {{host}}/api/v1/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "", "password": "test1234"}

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 18. Sans mot de passe → 400 RG-U03
POST {{host}}/api/v1/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "sansmdp", "role": "USER"}

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 19. Username trop court (@Length min 3 sur l'entité) → 400
POST {{host}}/api/v1/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "ab", "password": "test1234", "role": "USER"}

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 20. PUT sur id inexistant → 404
PUT {{host}}/api/v1/users/999
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "fantome", "role": "USER"}

> {% client.test("404", () => client.assert(response.status === 404, "status " + response.status)); %}


### ================= D. DROITS PAR RÔLE =================

### 21. Login testuser
POST {{host}}/api/v1/auth/login/
Content-Type: application/json

{"username": "testuser", "password": "test1234"}

> {%
    client.test("200", () => client.assert(response.status === 200, "status " + response.status));
    client.global.set("userToken", response.body.accessToken);
%}

### 22. USER peut lister → 200
GET {{host}}/api/v1/users/
Authorization: Bearer {{userToken}}

> {% client.test("200", () => client.assert(response.status === 200, "status " + response.status)); %}

### 23. USER ne peut pas créer → 403
POST {{host}}/api/v1/users
Authorization: Bearer {{userToken}}
Content-Type: application/json

{"username": "pirate", "password": "test1234", "role": "ADMIN"}

> {% client.test("403", () => client.assert(response.status === 403, "status " + response.status)); %}


### ================= E. UPDATE / DÉSACTIVATION =================

### 24. PUT sans mot de passe (change le rôle) → 200, mot de passe conservé
PUT {{host}}/api/v1/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "testuser", "role": "SUPER_USER"}

> {% client.test("200", () => client.assert(response.status === 200, "status " + response.status)); %}

### 25. Le mot de passe marche toujours → 200
POST {{host}}/api/v1/auth/login/
Content-Type: application/json

{"username": "testuser", "password": "test1234"}

> {%
    client.test("200", () => client.assert(response.status === 200, "status " + response.status));
    client.global.set("userToken", response.body.accessToken);
%}

### 26. Désactivation → 200, active = false
PUT {{host}}/api/v1/users/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"username": "testuser", "role": "SUPER_USER", "active": false}

> {% client.test("active false", () => client.assert(response.body.active === false, "active " + response.body.active)); %}

### 27. Ancien token du user désactivé → 401
GET {{host}}/api/v1/users/
Authorization: Bearer {{userToken}}

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}

### 28. Refresh du user désactivé (cookie de l'étape 25) → 400 RG-SEC04
POST {{host}}/api/v1/auth/refresh/

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 29. Login du user désactivé → 401
POST {{host}}/api/v1/auth/login/
Content-Type: application/json

{"username": "testuser", "password": "test1234"}

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}
